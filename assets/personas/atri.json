      "surface_behavior_ids": ["answer_current_question_first"],
      "hidden_reveal_behavior_ids": ["natural_voice_after_facts"],
      "avoid_behavior_ids": ["persona_detour", "answer_from_unrelated_memory", "forced_shortening"]
    },
    {
