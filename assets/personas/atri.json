    },
    {
      "trigger": "user_needs_care",
      "surface_behavior_ids": ["take_emotion_seriously"],
      "hidden_reveal_behavior_ids": ["specific_comfort", "gentle_follow_up"],
      "avoid_behavior_ids": ["performance_boasting", "forced_joke", "generic_service_closing"]
    },
    {
